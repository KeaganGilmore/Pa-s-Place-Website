---
import { Image } from 'astro:assets';
import logo from '../assets/brand/pas-place-logo.png';
import WaveDivider from './WaveDivider.astro';
import { getSettings } from '../lib/cms';

const settings = await getSettings();
const year = new Date().getFullYear();
---

<footer>
  <WaveDivider fill="var(--color-bark-950)" />
  <div class="bg-bark-950 text-cream-100">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 pb-12 pt-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <Image src={logo} alt="Pa's Place — dove and sunburst logo" widths={[128, 192]} sizes="64px" class="h-16 w-16 object-contain" />
          <span class="font-display text-2xl font-bold text-paper">Pa&rsquo;s Place</span>
        </div>
        <p class="mt-4 max-w-sm text-cream-100/75">
          A non-profit company giving coastal, fun-filled holidays to disadvantaged children —
          and restful, affordable stays to the families who need them.
        </p>
        <p class="mt-4 font-display text-lg italic text-marigold-300">
          Every child deserves to see the sea.
        </p>
      </div>

      <div>
        <h2 class="text-[0.7rem] font-extrabold uppercase tracking-[0.22em] text-marigold-400">Reach out</h2>
        <ul class="mt-4 space-y-2.5 text-cream-100/85">
          {settings.contact.person && <li>Ask for {settings.contact.person}</li>}
          {
            settings.contact.phone && (
              <li>
                <a class="underline-offset-4 hover:text-paper hover:underline" href={`tel:${settings.contact.phoneLink || settings.contact.phone}`}>
                  {settings.contact.phone}
                </a>
              </li>
            )
          }
          {
            settings.contact.email && (
              <li>
                <a class="underline-offset-4 hover:text-paper hover:underline" href={`mailto:${settings.contact.email}`}>
                  {settings.contact.email}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <div>
        <h2 class="text-[0.7rem] font-extrabold uppercase tracking-[0.22em] text-marigold-400">Find us</h2>
        <p class="mt-4 whitespace-pre-line text-cream-100/85">{settings.contact.address}</p>
        {
          settings.contact.mapUrl && (
            <a class="mt-3 inline-block font-bold text-marigold-300 underline-offset-4 hover:underline" href={settings.contact.mapUrl}>
              Open the map &rarr;
            </a>
          )
        }
      </div>
    </div>

    <div class="border-t border-bark-900">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-5 text-sm text-cream-100/55">
        <p>&copy; {year} Pa&rsquo;s Place NPC. All rights reserved.</p>
        <p>Made with love on the South Coast.</p>
      </div>
    </div>
  </div>
</footer>
