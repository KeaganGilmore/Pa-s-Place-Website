---
// The quick facts a guest wants before anything else.
interface Props {
  accommodation?: string;
  venue?: string;
}
const { accommodation, venue } = Astro.props;

const facts = [
  {
    title: '2 minutes to the beach',
    text: 'Down the road, over the dune grass, toes in the sand.',
    icon: `<svg viewBox="0 0 64 64" class="h-11 w-11" fill="none" aria-hidden="true">
      <g fill="#5c4a36" opacity="0.85">
        <ellipse cx="22" cy="46" rx="6" ry="9" transform="rotate(-12 22 46)"/>
        <ellipse cx="38" cy="30" rx="6" ry="9" transform="rotate(-8 38 30)"/>
      </g>
      <path d="M8 58 h48 M14 16 h22" stroke="#4f93a3" stroke-width="3.5" stroke-linecap="round" opacity="0.7"/>
      <circle cx="50" cy="12" r="7" fill="#f7ae3c"/>
    </svg>`,
  },
  {
    title: accommodation ? accommodation.split(' (')[0] : 'affordable rates',
    text: accommodation?.includes('(') ? accommodation.slice(accommodation.indexOf('(') + 1, -1) : 'priced so everyone can get away',
    icon: `<svg viewBox="0 0 64 64" class="h-11 w-11" fill="none" aria-hidden="true">
      <path d="M12 26 L30 10 a4 4 0 0 1 5 0 L52 26 v24 a4 4 0 0 1 -4 4 H16 a4 4 0 0 1 -4 -4 Z" fill="#f6ead1" stroke="#423424" stroke-width="3.5" stroke-linejoin="round"/>
      <text x="32" y="44" text-anchor="middle" font-family="var(--font-hand)" font-weight="700" font-size="20" fill="#d1770e">R</text>
    </svg>`,
  },
  {
    title: 'families & groups',
    text: 'School holidays, church groups, big birthdays, quiet weekends.',
    icon: `<svg viewBox="0 0 64 64" class="h-11 w-11" fill="none" aria-hidden="true">
      <circle cx="22" cy="22" r="8" fill="#7a5a42"/>
      <circle cx="42" cy="26" r="6" fill="#7a5a42"/>
      <path d="M10 52 a12 12 0 0 1 24 0 Z" fill="#3e7e8e"/>
      <path d="M34 52 a9 9 0 0 1 18 0 Z" fill="#f7ae3c"/>
    </svg>`,
  },
  {
    title: 'venue hire',
    text: venue ?? 'Ask us about hosting your gathering.',
    icon: `<svg viewBox="0 0 64 64" class="h-11 w-11" fill="none" aria-hidden="true">
      <g stroke="#b4dceb" stroke-width="3" stroke-linecap="round"><path d="M26 16 c-2 -4 2 -6 0 -10"/><path d="M38 16 c-2 -4 2 -6 0 -10"/></g>
      <ellipse cx="32" cy="24" rx="17" ry="4" fill="#33291c"/>
      <path d="M15 24 h34 v6 a17 12 0 0 1 -34 0 Z" fill="#423424"/>
      <path d="M11 21 l6 4 M53 21 l-6 4" stroke="#33291c" stroke-width="4" stroke-linecap="round"/>
    </svg>`,
  },
];
---

<section class="bg-paper" aria-label="Quick facts">
  <ul class="mx-auto grid max-w-6xl gap-5 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      facts.map((f) => (
        <li class="reveal flex items-start gap-4 rounded-[1.3rem] border-2 border-bark-900/10 bg-[#fffdf6] p-5 shadow-[0_16px_32px_-22px_rgb(24_18_10/0.45)]">
          <Fragment set:html={f.icon} />
          <div>
            <h2 class="font-display text-lg font-semibold leading-snug text-bark-900">{f.title}</h2>
            <p class="mt-1 text-sm text-cocoa/75">{f.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
