---
// The house itself — what guests are really here to see.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  housePhoto?: ImageMetadata;
  houseAlt?: string;
  houseCaption?: string | null;
  beachPhoto: ImageMetadata;
  pricing: string;
  phone?: string;
  phoneLink?: string;
  whatsapp?: string;
}
const { housePhoto, houseAlt = "The Pa's Place house", houseCaption, beachPhoto, pricing, phone, phoneLink, whatsapp } = Astro.props;

const includes = [
  'a peaceful, quiet setting a street back from the sea',
  'space for families and groups (minimum 4 people)',
  'a playground that has seen some serious games',
  'beach, rock pools and trails all within a short walk',
];
---

<section id="place" class="relative bg-paper" aria-label="The place">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-6 sm:pt-10 lg:grid-cols-[1.05fr_1fr]">
    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      {
        housePhoto && (
          <figure class="keepsake !-rotate-1">
            <Image
              src={housePhoto}
              alt={houseAlt}
              widths={[480, 800, 1100]}
              sizes="(min-width: 1024px) 45vw, 92vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <figcaption class="hand pt-3 text-center text-[1.4rem] text-cocoa/85">{houseCaption ?? 'home base'}</figcaption>
          </figure>
        )
      }
      <figure class="keepsake absolute -bottom-10 -right-2 hidden w-52 !rotate-2 sm:block lg:-right-8 lg:w-60">
        <Image
          src={beachPhoto}
          alt="The beach at Pennington, two minutes' walk from the house"
          widths={[320, 480]}
          sizes="240px"
          class="aspect-[4/3] w-full object-cover"
        />
        <figcaption class="hand pt-2 text-center text-lg text-cocoa/85">&larr; two minutes this way</figcaption>
      </figure>
    </div>

    <div class="reveal lg:pl-6">
      <p class="hand text-2xl text-sea-600">the place</p>
      <h2 class="mt-2 font-display text-4xl font-semibold text-bark-900 sm:text-5xl">A proper old beach house, kept simple</h2>
      <p class="mt-5 max-w-lg text-lg text-cocoa/85">
        Comfortable, peaceful and activity-filled — the kind of place where shoes go missing on
        day one and nobody minds. Book the dates, bring the people, we&rsquo;ll have the sea ready.
      </p>

      <ul class="mt-6 space-y-2.5">
        {
          includes.map((item) => (
            <li class="flex items-start gap-3 text-cocoa/85">
              <svg class="mt-1 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="#fbc968" opacity="0.4" />
                <path d="M7 12.5 l3.2 3.3 L17 9" stroke="#d1770e" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>

      <p class="relative mt-7 inline-block rounded-xl border-2 border-bark-900/10 bg-cream-100 px-5 py-3">
        <span class="tape" aria-hidden="true"></span>
        <span class="hand text-2xl text-bark-900">{pricing}</span>
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-4">
        {phone && <a href={`tel:${phoneLink || phone}`} class="btn btn-marigold">Call {phone}</a>}
        {whatsapp && <a href={whatsapp} class="btn btn-bark">WhatsApp us</a>}
        <a href="/book-a-stay" class="hand text-2xl text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900">
          all the details &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
