---
// The one gentle mention on the guest-facing homepage: this place exists
// for a reason, and there's a storybook about it.
import Dove from '../story/Dove.astro';
---

<section class="bg-paper" aria-label="Our cause">
  <div class="mx-auto max-w-3xl px-5 pb-20 pt-8 text-center sm:pb-24">
    <div class="mx-auto w-20">
      <Dove class="h-auto w-full" star />
    </div>
    <p class="reveal hand mt-4 text-2xl leading-snug text-bark-700 sm:text-3xl">
      Pa&rsquo;s Place is a registered nonprofit. Every night you book helps give a child
      who&rsquo;s never seen the sea their first holiday beside it.
    </p>
    <a href="/our-story" class="btn btn-bark mt-7">Read the story</a>
  </div>
</section>
