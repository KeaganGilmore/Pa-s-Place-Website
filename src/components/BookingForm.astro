---
// A booking-request form with no backend: it composes a tidy WhatsApp or
// email message from the fields, so a request takes one tap and Luke gets
// everything he needs to confirm dates and send payment details.
interface Props {
  kind: 'stay' | 'venue';
  email?: string;
  whatsappDigits?: string;
}
const { kind, email, whatsappDigits } = Astro.props;
const isStay = kind === 'stay';
---

<form
  data-booking-form
  data-kind={kind}
  data-wa={whatsappDigits}
  data-email={email}
  class="relative rounded-[1.6rem] border-2 border-bark-900/10 bg-[#fffdf6] p-6 shadow-[0_26px_52px_-28px_rgb(24_18_10/0.5)] sm:p-8"
  aria-label={isStay ? 'Booking request' : 'Venue hire request'}
>
  <span class="tape" aria-hidden="true"></span>
  <h2 class="font-display text-2xl font-semibold text-bark-900 sm:text-3xl">
    {isStay ? 'Request your dates' : 'Request your event date'}
  </h2>
  <p class="hand mt-1 text-xl text-bark-700/80">
    one tap sends it all to us &mdash; we reply with availability &amp; payment details
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-bold text-bark-900">Your name</span>
      <input name="name" type="text" autocomplete="name" class="frm mt-1.5" placeholder="e.g. The Dlamini family" />
    </label>
    <label class="block">
      <span class="text-sm font-bold text-bark-900">Phone (for our reply)</span>
      <input name="phone" type="tel" autocomplete="tel" class="frm mt-1.5" placeholder="073 …" />
    </label>
    {
      isStay ? (
        <>
          <label class="block">
            <span class="text-sm font-bold text-bark-900">Arriving</span>
            <input name="arrive" type="date" class="frm mt-1.5" />
          </label>
          <label class="block">
            <span class="text-sm font-bold text-bark-900">Leaving</span>
            <input name="depart" type="date" class="frm mt-1.5" />
          </label>
        </>
      ) : (
        <label class="block">
          <span class="text-sm font-bold text-bark-900">Event date</span>
          <input name="eventdate" type="date" class="frm mt-1.5" />
        </label>
      )
    }
    <label class="block">
      <span class="text-sm font-bold text-bark-900">{isStay ? 'How many of you? (min 4)' : 'How many guests? (min 10)'}</span>
      <input name="people" type="number" min={isStay ? 4 : 10} class="frm mt-1.5" placeholder={isStay ? '6' : '20'} />
    </label>
    <label class="block sm:col-span-2">
      <span class="text-sm font-bold text-bark-900">Anything we should know?</span>
      <textarea name="notes" rows="2" class="frm mt-1.5" placeholder={isStay ? 'small kids, a gran who loves birds…' : 'a 60th birthday, long tables for 30…'}></textarea>
    </label>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    {whatsappDigits && (
      <button type="button" data-send="wa" class="btn btn-marigold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.3 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.2Z" />
        </svg>
        Send via WhatsApp
      </button>
    )}
    {email && (
      <button type="button" data-send="mail" class="btn btn-bark">Send via email</button>
    )}
    <p class="hand text-lg text-bark-700/70">no logins, no card forms — just a message to a person</p>
  </div>
</form>

<style>
  .frm {
    display: block;
    width: 100%;
    border-radius: 0.8rem;
    border: 2px solid color-mix(in srgb, var(--color-bark-900) 14%, transparent);
    background: var(--color-paper);
    padding: 0.6rem 0.9rem;
    color: var(--color-cocoa);
    font-size: 1rem;
  }
  .frm:focus {
    outline: none;
    border-color: var(--color-marigold-500);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-marigold-400) 30%, transparent);
  }
</style>

<script>
  // Compose the request message from whatever was filled in, then hand it
  // to WhatsApp or the mail client. Runs for every form on the page.
  const wire = () => {
    document.querySelectorAll<HTMLFormElement>('[data-booking-form]').forEach((form) => {
      if (form.dataset.wired) return;
      form.dataset.wired = 'true';
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value?.trim() ?? '';
      const compose = () => {
        const isStay = form.dataset.kind === 'stay';
        const lines = [
          isStay ? "Hi! We'd like to book a stay at Pa's Place." : "Hi! We'd like to hire the venue at Pa's Place.",
          val('name') && `Name: ${val('name')}`,
          val('phone') && `Phone: ${val('phone')}`,
          isStay && val('arrive') && `Arriving: ${val('arrive')}`,
          isStay && val('depart') && `Leaving: ${val('depart')}`,
          !isStay && val('eventdate') && `Event date: ${val('eventdate')}`,
          val('people') && `People: ${val('people')}`,
          val('notes') && `Notes: ${val('notes')}`,
        ].filter(Boolean);
        return lines.join('\n');
      };
      form.querySelector('[data-send="wa"]')?.addEventListener('click', () => {
        const wa = form.dataset.wa;
        if (wa) window.open(`https://wa.me/${wa}?text=${encodeURIComponent(compose())}`, '_blank', 'noopener');
      });
      form.querySelector('[data-send="mail"]')?.addEventListener('click', () => {
        const email = form.dataset.email;
        const subject = form.dataset.kind === 'stay' ? "Booking request — Pa's Place" : "Venue hire request — Pa's Place";
        if (email) {
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(compose())}`;
        }
      });
    });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
