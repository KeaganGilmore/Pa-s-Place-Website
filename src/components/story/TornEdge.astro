---
// A torn-paper seam between two pages of the book. The tear is a seeded
// random walk so every seam is irregular but stable across builds.
// `fill` is the colour of the page BELOW the tear; `flip` turns it upside
// down for a tear at the bottom of a section.
interface Props {
  fill: string;
  flip?: boolean;
  class?: string;
  seed?: number;
}
const { fill, flip = false, class: className = '', seed = 7 } = Astro.props;

// mulberry32 — tiny deterministic PRNG
const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = mulberry32(seed);

const W = 1440;
const H = 36;
const pts: string[] = [];
let y = 16 + rand() * 8;
for (let x = 0; x <= W; x += 18 + Math.floor(rand() * 22)) {
  y += (rand() - 0.5) * 11;
  y = Math.max(5, Math.min(29, y));
  pts.push(`L${x},${y.toFixed(1)}`);
}
const path = `M0,${H} ${pts.join(' ')} L${W},${y.toFixed(1)} L${W},${H} Z`;

// a paler under-layer peeking out above the tear = the torn fibre edge
const fiberPts: string[] = [];
const rand2 = mulberry32(seed + 101);
let y2 = 13 + rand2() * 8;
for (let x = 0; x <= W; x += 14 + Math.floor(rand2() * 26)) {
  y2 += (rand2() - 0.5) * 10;
  y2 = Math.max(2, Math.min(26, y2));
  fiberPts.push(`L${x},${y2.toFixed(1)}`);
}
const fiberPath = `M0,${H} ${fiberPts.join(' ')} L${W},${y2.toFixed(1)} L${W},${H} Z`;
---

<div class={`${flip ? 'rotate-180' : ''} ${className} pointer-events-none`} aria-hidden="true">
  <svg class="block h-[26px] w-full sm:h-[36px]" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d={fiberPath} fill={fill} opacity="0.45"></path>
    <path d={path} fill={fill}></path>
  </svg>
</div>
