---
// The opening of a chapter page: number, title, a handwritten aside,
// and the sun peeking over the corner of the page.
import Sunburst from './Sunburst.astro';
import TornEdge from './TornEdge.astro';

interface Props {
  chapter: string;
  title: string;
  note?: string;
  seed?: number;
}
const { chapter, title, note, seed = 53 } = Astro.props;
---

<section class="relative overflow-hidden bg-cream-100">
  <Sunburst class="absolute -right-16 -top-20 h-56 w-56 opacity-70 sm:-right-10 sm:h-72 sm:w-72" spin />
  <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-28 sm:pb-16 sm:pt-36">
    <p class="hand fade-up text-2xl text-marigold-600" style="--d: 0.05s">chapter {chapter}</p>
    <h1 class="fade-up mt-3 max-w-3xl font-display text-[2.6rem] font-semibold leading-[1.06] text-bark-900 sm:text-6xl" style="--d: 0.18s">
      {title}
    </h1>
    {
      note && (
        <p class="hand fade-up mt-5 max-w-xl text-2xl text-bark-700/80" style="--d: 0.32s">
          {note}
        </p>
      )
    }
  </div>
  <TornEdge fill="var(--color-paper)" seed={seed} class="relative" />
</section>
