---
// A handful of fireflies drifting over the foreground of a night scene.
interface Props {
  class?: string;
  count?: number;
  seed?: number;
}
const { class: className = '', count = 7, seed = 11 } = Astro.props;

const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = mulberry32(seed);

const flies = Array.from({ length: count }, () => ({
  x: 60 + rand() * 880,
  y: 60 + rand() * 320,
  delay: rand() * 6,
}));
---

<svg class={className} viewBox="0 0 1000 440" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {
    flies.map((f) => (
      <g class="firefly" style={`--tw-delay: ${f.delay.toFixed(1)}s`}>
        <circle cx={f.x.toFixed(0)} cy={f.y.toFixed(0)} r="5.5" fill="#fbc968" opacity="0.22" />
        <circle cx={f.x.toFixed(0)} cy={f.y.toFixed(0)} r="1.8" fill="#fbc968" />
      </g>
    ))
  }
</svg>
