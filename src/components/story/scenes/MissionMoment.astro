---
// Page two: the mission, in one breath. A drawn morning opens — once,
// gently, no scroll-jacking — into the real photograph of a first
// meeting with the sea.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo: ImageMetadata;
  photoAlt: string;
}
const { photo, photoAlt } = Astro.props;
---

<section data-scene="mission" class="relative min-h-[560px] overflow-hidden bg-paper sm:h-[88svh]" aria-label="Why Pa's Place exists">
  <!-- the drawn morning (visible for the blink before the page opens) -->
  <svg
    class="absolute inset-0 h-full w-full"
    viewBox="0 0 1440 800"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="mission-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-paper)"></stop>
        <stop offset="62%" stop-color="#fbe3b0"></stop>
        <stop offset="100%" stop-color="#f8d492"></stop>
      </linearGradient>
    </defs>

    <rect width="1440" height="430" fill="url(#mission-sky)"></rect>

    <g>
      <circle cx="720" cy="300" r="70" fill="var(--color-marigold-300)" opacity="0.25"></circle>
      <circle cx="720" cy="300" r="38" fill="var(--color-marigold-400)"></circle>
      <g stroke="var(--color-marigold-500)" stroke-width="5" stroke-linecap="round">
        <path d="M720 240 v-24 M720 360 v24 M660 300 h-24 M780 300 h24 M678 258 l-17 -17 M762 342 l17 17 M762 258 l17 -17 M678 342 l-17 17"></path>
      </g>
    </g>

    <g stroke="var(--color-bark-700)" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.7">
      <path d="M520 180 c8 -9 18 -9 25 -1 c7 -8 17 -8 25 1"></path>
      <path d="M920 150 c7 -8 15 -8 21 -1 c6 -7 14 -7 21 1"></path>
    </g>

    <g class="waft">
      <path d="M-40,430 C80,412 200,446 340,432 C480,418 600,450 740,436 C880,422 1000,452 1140,438 C1280,424 1380,444 1480,432 L1480,520 L-40,520 Z" fill="var(--color-sea-500)"></path>
    </g>
    <g class="waft-late">
      <path d="M-40,472 C120,458 260,486 420,474 C580,462 720,490 880,478 C1040,466 1180,492 1330,480 L1480,472 L1480,560 L-40,560 Z" fill="var(--color-sea-600)"></path>
    </g>
    <rect x="-40" y="540" width="1520" height="46" fill="#e8d9c2"></rect>
    <rect x="-40" y="576" width="1520" height="224" fill="var(--color-cream-300)"></rect>
  </svg>

  <!-- the real morning -->
  <div data-mission-photo class="absolute inset-0 z-10">
    <Image
      src={photo}
      alt={photoAlt}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-bark-950/85 via-bark-950/30 to-transparent" aria-hidden="true"></div>
    <div data-mission-caption class="absolute inset-x-0 bottom-0 z-10 mx-auto w-full max-w-6xl px-5 pb-14 sm:pb-16">
      <h2 class="max-w-3xl font-display text-3xl font-semibold italic text-paper sm:text-5xl">
        The greatest joy we witness is a child seeing the sea for the very first time.
      </h2>
      <p class="hand mt-4 text-2xl text-marigold-300">&mdash; most of the children we host never have. We exist to change that.</p>
      <a href="/our-story" class="btn btn-marigold btn-on-night mt-7">Read our story</a>
    </div>
  </div>

  <p class="hand absolute bottom-4 right-6 z-20 text-lg text-paper/60">&middot; two &middot;</p>
</section>

<style>
  /* Default (no JS, reduced motion): the photograph is simply there.
     The script closes the iris at init, then .is-open lets a CSS
     transition open it — time-based, so it completes even when frames
     are throttled (background/occluded tabs, low-power mode). */
  [data-mission-photo] {
    clip-path: circle(145% at 50% 37%);
  }
  section.iris-closed [data-mission-photo] {
    clip-path: circle(0% at 50% 37%);
  }
  section.iris-open [data-mission-photo] {
    clip-path: circle(145% at 50% 37%);
    transition: clip-path 1.7s cubic-bezier(0.65, 0, 0.35, 1);
  }
  section.iris-closed [data-mission-caption] {
    opacity: 0;
    transform: translateY(36px);
  }
  section.iris-open [data-mission-caption] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s ease 1s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1s;
  }
</style>
