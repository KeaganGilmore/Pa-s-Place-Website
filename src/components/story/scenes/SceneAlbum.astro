---
// The family album — real film photographs taped into a simple grid.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface AlbumPhoto {
  meta: ImageMetadata;
  alt: string;
  caption?: string | null;
}
interface Props {
  photos: AlbumPhoto[];
}
const { photos } = Astro.props;
---

<section class="relative bg-paper" aria-label="The family album">
  <div class="mx-auto max-w-6xl px-5 pb-20 pt-14 sm:pt-16">
    <div class="reveal flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
      <div>
        <p class="hand text-2xl text-marigold-600">from the family album</p>
        <h2 class="mt-2 font-display text-4xl font-semibold text-bark-900 sm:text-5xl">Days at Pa&rsquo;s Place</h2>
      </div>
      <p class="hand max-w-xs pb-2 text-xl leading-snug text-bark-700/80">
        real days &mdash; with real sand that came home in real shoes
      </p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        photos.map((p) => (
          <figure class="keepsake keepsake-tilt reveal">
            <Image
              src={p.meta}
              alt={p.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
              class="aspect-square w-full object-cover"
            />
            {p.caption && <figcaption class="hand pt-3 text-center text-[1.35rem] leading-snug text-cocoa/85">{p.caption}</figcaption>}
          </figure>
        ))
      }

      <!-- the empty frame -->
      <figure class="keepsake reveal !rotate-1">
        <div class="grid aspect-square w-full place-items-center rounded-[2px] border-4 border-dashed border-cream-300 bg-[#fffcf3] p-8 text-center">
          <div>
            <p class="hand text-[1.5rem] leading-snug text-bark-700">
              this frame is waiting for a child who hasn&rsquo;t met the sea yet.
            </p>
            <a href="/our-story" class="btn btn-marigold mt-5">Read the story</a>
          </div>
        </div>
        <figcaption class="hand pt-3 text-center text-[1.35rem] text-cocoa/85">the next photo &rarr;</figcaption>
      </figure>
    </div>
  </div>
</section>
