---
// Page one: the practical page. A warm, no-fuss booking band for guests —
// the single most important action on the site.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TornEdge from '../TornEdge.astro';

interface Props {
  photo?: ImageMetadata;
  photoAlt?: string;
  pricing: string;
  phone?: string;
  phoneLink?: string;
  whatsapp?: string;
}
const { photo, photoAlt = "The Pa's Place house", pricing, phone, phoneLink, whatsapp } = Astro.props;
---

<section id="stay" class="relative bg-paper" aria-label="Book a stay">
  <TornEdge fill="var(--color-paper)" seed={47} class="relative z-10 -mt-[25px] sm:-mt-[35px]" />

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-14 sm:pt-16 lg:grid-cols-[1fr_1.1fr]">
    {
      photo && (
        <figure class="keepsake reveal mx-auto w-full max-w-md !-rotate-1 lg:max-w-none">
          <Image
            src={photo}
            alt={photoAlt}
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="hand pt-3 text-center text-[1.4rem] text-cocoa/85">home base — a two-minute wander from the waves</figcaption>
        </figure>
      )
    }

    <div class="reveal">
      <p class="hand text-2xl text-sea-600">for families, groups &amp; school holidays</p>
      <h2 class="mt-2 font-display text-4xl font-semibold text-bark-900 sm:text-5xl">Stay by the sea</h2>
      <p class="mt-5 max-w-lg text-lg text-cocoa/85">
        Comfortable, peaceful beachside accommodation in Kelso, Pennington — two minutes&rsquo; walk
        from the water. Simple to book: one call, your dates, done.
      </p>

      <p class="relative mt-7 inline-block rounded-xl border-2 border-bark-900/10 bg-cream-100 px-5 py-3">
        <span class="tape" aria-hidden="true"></span>
        <span class="hand text-2xl text-bark-900">{pricing}</span>
      </p>

      <p class="hand mt-4 text-xl text-marigold-600">
        &mdash; and every paid night helps fund a child&rsquo;s seaside retreat.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        {phone && <a href={`tel:${phoneLink || phone}`} class="btn btn-marigold">Call {phone}</a>}
        {
          whatsapp && (
            <a href={whatsapp} class="btn btn-paper">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.1-.3 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.2Z" />
              </svg>
              WhatsApp us
            </a>
          )
        }
        <a href="/book-a-stay" class="hand self-center text-2xl text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900">
          all the details &rarr;
        </a>
      </div>
    </div>
  </div>

  <p class="hand pb-4 pr-6 text-right text-lg text-bark-700/50">&middot; one &middot;</p>
</section>
