---
// Page three: the notebook that travels along on every retreat. The left
// page is written the night before; the right page, on day one at the sea —
// and the dream's questions come back answered, in a child's hand.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TornEdge from '../TornEdge.astro';

interface Props {
  photo: ImageMetadata;
  photoAlt: string;
}
const { photo, photoAlt } = Astro.props;

// school-exercise-book ruling
const ruled =
  'background-image: repeating-linear-gradient(to bottom, transparent, transparent 34px, rgba(62,126,142,0.22) 34px, rgba(62,126,142,0.22) 35.5px); background-position: 0 12px;';
---

<section class="relative bg-paper" aria-label="Page three — the notebook that travels along">
  <TornEdge fill="var(--color-paper)" seed={97} class="relative z-10 -mt-[25px] sm:-mt-[35px]" />

  <div class="mx-auto max-w-6xl px-5 pb-20 pt-14 sm:pt-16">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="hand text-2xl text-marigold-600">every retreat, a notebook goes along</p>
      <h2 class="mt-2 font-display text-4xl font-semibold text-bark-900 sm:text-5xl">And this is what they say</h2>
    </div>

    <!-- the notebook -->
    <div class="reveal relative mx-auto mt-12 max-w-4xl -rotate-1">
      <span class="tape !-top-3 !left-[18%]" aria-hidden="true"></span>
      <span class="tape !-top-3 !left-auto !right-[14%] rotate-3" aria-hidden="true"></span>

      <div class="grid overflow-hidden rounded-[1.2rem] shadow-[0_34px_64px_-30px_rgb(24_18_10/0.6)] md:grid-cols-2">
        <!-- left page: the night before -->
        <div class="relative bg-[#fffef8] p-7 pb-9 sm:p-9" style={ruled}>
          <div class="absolute bottom-0 left-10 top-0 w-[2px] bg-ember/25" aria-hidden="true"></div>
          <div class="relative pl-6">
            <p class="hand text-2xl text-sea-800 sm:text-[1.7rem]">the night before.</p>
            <p class="hand mt-4 text-xl leading-[35px] text-bark-900 sm:text-2xl">
              tomorrow we go to the ACTUAL sea.<br />
              things I will find out:
            </p>
            <ul class="hand mt-2 space-y-[7px] text-xl text-bark-900 sm:text-2xl">
              <li class="flex items-baseline gap-3">
                <span class="inline-block h-4 w-4 shrink-0 translate-y-0.5 rounded-[3px] border-2 border-sea-800/60"></span>
                is it bigger than the river?
              </li>
              <li class="flex items-baseline gap-3">
                <span class="inline-block h-4 w-4 shrink-0 translate-y-0.5 rounded-[3px] border-2 border-sea-800/60"></span>
                does it really roar?
              </li>
              <li class="flex items-baseline gap-3">
                <span class="inline-block h-4 w-4 shrink-0 translate-y-0.5 rounded-[3px] border-2 border-sea-800/60"></span>
                how salty is salty?
              </li>
            </ul>
            <p class="hand mt-5 text-xl text-bark-900/85 sm:text-2xl">packed: the red cap. gogo&rsquo;s scarf. my lucky marble.</p>

            <!-- crayon moon + stars doodle -->
            <svg class="mt-4 h-16 w-24" viewBox="0 0 120 70" fill="none" aria-hidden="true">
              <path d="M52 8 a26 26 0 1 0 16 46 a22 22 0 0 1 -16 -46 Z" fill="#8d97c9" opacity="0.8" />
              <path d="M88 18 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 Z" fill="#f7ae3c" />
              <path d="M104 42 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5 Z" fill="#f7ae3c" />
            </svg>
          </div>
        </div>

        <!-- right page: day one -->
        <div class="relative border-t-2 border-dashed border-cream-300 bg-[#fffef8] p-7 pb-9 sm:p-9 md:border-l-2 md:border-t-0" style={ruled}>
          <div class="relative">
            <p class="hand text-2xl text-sea-800 sm:text-[1.7rem]">DAY ONE. I saw the sea.</p>

            <ul class="hand mt-4 space-y-[7px] text-xl text-bark-900 sm:text-2xl">
              <li class="flex items-baseline gap-3">
                <svg class="h-5 w-5 shrink-0 translate-y-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4" stroke="rgba(41,88,106,0.6)" stroke-width="2.4" />
                  <path d="M6.5 12.5 l4 4 L18 7.5" stroke="#d1770e" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                it IS bigger than the river. it is bigger than EVERYTHING.
              </li>
              <li class="flex items-baseline gap-3">
                <svg class="h-5 w-5 shrink-0 translate-y-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4" stroke="rgba(41,88,106,0.6)" stroke-width="2.4" />
                  <path d="M6.5 12.5 l4 4 L18 7.5" stroke="#d1770e" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                it does roar. it also whispers when it goes back.
              </li>
              <li class="flex items-baseline gap-3">
                <svg class="h-5 w-5 shrink-0 translate-y-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="4" stroke="rgba(41,88,106,0.6)" stroke-width="2.4" />
                  <path d="M6.5 12.5 l4 4 L18 7.5" stroke="#d1770e" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                salty is VERY salty.
              </li>
            </ul>

            <figure class="keepsake mx-auto mt-6 max-w-[240px] !rotate-2 !p-2 !pb-3">
              <Image
                src={photo}
                alt={photoAlt}
                widths={[320, 480]}
                sizes="240px"
                class="aspect-[4/3] w-full object-cover"
              />
              <figcaption class="hand pt-2 text-center text-lg text-cocoa/85">me and Pa. my first wave.</figcaption>
            </figure>

            <p class="hand mt-4 text-xl text-bark-900/85 sm:text-2xl">the water chased me and I chased it back.</p>

            <!-- crayon sun + wave doodle -->
            <svg class="absolute -right-1 top-0 h-14 w-14 sm:h-16 sm:w-16" viewBox="0 0 80 80" fill="none" aria-hidden="true">
              <circle cx="40" cy="40" r="15" fill="#f7ae3c" />
              <g stroke="#d1770e" stroke-width="3.5" stroke-linecap="round">
                <path d="M40 18 v-8 M40 62 v8 M18 40 h-8 M62 40 h8 M25 25 l-6 -6 M55 55 l6 6 M55 25 l6 -6 M25 55 l-6 6" />
              </g>
            </svg>
            <svg class="mt-3 h-6 w-32" viewBox="0 0 140 20" fill="none" aria-hidden="true">
              <path d="M4 12 q8 -10 17 0 t17 0 t17 0 t17 0 t17 0 t17 0" stroke="#4f93a3" stroke-width="3.5" stroke-linecap="round" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <p class="reveal hand mx-auto mt-10 max-w-xl text-center text-2xl leading-snug text-bark-700/85">
      pages like these are why Pa&rsquo;s Place exists &mdash; and why the door stays open.
    </p>
  </div>

  <p class="hand pb-4 pr-6 text-right text-lg text-bark-700/50">&middot; three &middot;</p>
</section>
