---
// Page five: how the story keeps getting told — the three tides of work,
// pinned to the page like notes on a kitchen wall.

const tides = [
  {
    title: 'Seaside retreats for children',
    text: 'Our reason for being. Fun-filled, carefully held holidays that lift children out of classrooms and familiar concerns — into salt air, rock pools and discovery.',
    link: { href: '/get-involved', label: 'sponsor one' },
    tilt: 'md:-rotate-1',
    art: `<svg viewBox="0 0 170 130" class="mx-auto h-28 w-auto" fill="none" aria-hidden="true">
      <ellipse cx="85" cy="112" rx="72" ry="12" fill="#e2cb9a"/>
      <path d="M84 34 L90 110" stroke="#5c4a36" stroke-width="5" stroke-linecap="round"/>
      <path d="M24 52 A62 62 0 0 1 146 48 L132 56 L112 46 L92 58 L70 46 L50 58 L34 48 Z" fill="#f7ae3c" stroke="#d1770e" stroke-width="4" stroke-linejoin="round"/>
      <path d="M62 18 Q84 4 108 16 L146 48 A62 62 0 0 0 24 52 Z" fill="#fbc968" opacity="0.55"/>
      <path d="M124 92 l22 -6 l4 18 l-20 6 Z" fill="#4f93a3" stroke="#29586a" stroke-width="3.5" stroke-linejoin="round"/>
      <path d="M128 88 q10 -10 20 -4" stroke="#29586a" stroke-width="3.5" stroke-linecap="round" fill="none"/>
      <circle cx="44" cy="98" r="9" fill="#e2673f" stroke="#5c4a36" stroke-width="3"/>
    </svg>`,
  },
  {
    title: 'Affordable family holidays',
    text: 'Comfortable, peaceful beachside stays priced for families who struggle to find the funds for rest — and every paid night helps fund a child’s retreat.',
    link: { href: '/book-a-stay', label: 'book one' },
    tilt: 'md:translate-y-4',
    art: `<svg viewBox="0 0 170 130" class="mx-auto h-28 w-auto" fill="none" aria-hidden="true">
      <path d="M12 116 C40 110 76 118 104 114 C130 110 152 116 160 114" stroke="#7d9a6a" stroke-width="4" stroke-linecap="round"/>
      <rect x="48" y="58" width="76" height="54" rx="3" fill="#f6ead1" stroke="#423424" stroke-width="4"/>
      <path d="M38 60 L86 26 L134 60 Z" fill="#f7ae3c" stroke="#423424" stroke-width="4" stroke-linejoin="round"/>
      <rect x="78" y="82" width="18" height="30" rx="7" fill="#5c4a36"/>
      <rect x="58" y="70" width="15" height="14" rx="2" fill="#b4dceb" stroke="#423424" stroke-width="3"/>
      <rect x="100" y="70" width="15" height="14" rx="2" fill="#b4dceb" stroke="#423424" stroke-width="3"/>
      <rect x="104" y="36" width="10" height="18" fill="#423424"/>
      <path d="M112 26 C116 20 110 16 114 10" stroke="#5c4a36" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 6"/>
      <path d="M142 100 a6 6 0 0 1 8 -8 a6 6 0 0 1 8 8 l-8 9 Z" fill="#e2673f"/>
    </svg>`,
  },
  {
    title: 'Community food & play days',
    text: 'Open days for our neighbours: big pots of unique, filling meals while local children fill the playground. Long tables, longer afternoons.',
    link: { href: '/what-we-do', label: 'see how they work' },
    tilt: 'md:rotate-1',
    art: `<svg viewBox="0 0 170 130" class="mx-auto h-28 w-auto" fill="none" aria-hidden="true">
      <g stroke="#b4dceb" stroke-width="4" stroke-linecap="round" fill="none">
        <path d="M64 34 C60 26 68 22 64 12"/>
        <path d="M85 36 C81 26 89 22 85 10"/>
        <path d="M106 34 C102 26 110 22 106 12"/>
      </g>
      <ellipse cx="85" cy="52" rx="46" ry="9" fill="#33291c"/>
      <path d="M39 52 h92 v14 a46 30 0 0 1 -92 0 Z" fill="#423424" stroke="#33291c" stroke-width="3"/>
      <path d="M30 46 l12 8 M140 46 l-12 8" stroke="#33291c" stroke-width="6" stroke-linecap="round"/>
      <path d="M120 30 l24 -14" stroke="#5c4a36" stroke-width="5" stroke-linecap="round"/>
      <ellipse cx="148" cy="13" rx="9" ry="6" fill="#eedcb6" stroke="#5c4a36" stroke-width="3" transform="rotate(-30 148 13)"/>
      <ellipse cx="85" cy="114" rx="58" ry="9" fill="#e2cb9a"/>
    </svg>`,
  },
];

const activities = ['beach going', 'rock pools', 'trail walks', 'team games', 'music & arts', 'unique foods', 'star gazing'];
const activityColors = ['text-marigold-600', 'text-sea-600', 'text-bark-700'];
---

<section
  data-scene="tides"
  class="relative"
  style="background: linear-gradient(to bottom, var(--color-paper), var(--color-cream-100));"
  aria-label="Page five — three tides of work"
>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="hand text-2xl text-sea-600">and between the first waves&hellip;</p>
      <h2 class="mt-2 font-display text-4xl font-semibold text-bark-900 sm:text-5xl">Three tides keep the story going</h2>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        tides.map((t) => (
          <article class={`reveal relative rounded-[1.5rem] border-2 border-bark-900/10 bg-[#fffdf6] p-7 pt-9 shadow-[0_22px_44px_-26px_rgb(24_18_10/0.5)] ${t.tilt}`}>
            <span class="tape" aria-hidden="true" />
            <Fragment set:html={t.art} />
            <h3 class="mt-6 text-center font-display text-2xl font-semibold text-bark-900">{t.title}</h3>
            <p class="mt-3 text-center text-cocoa/80">{t.text}</p>
            <p class="mt-4 text-center">
              <a href={t.link.href} class="hand text-xl text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900">
                {t.link.label} &rarr;
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-14 max-w-3xl text-center">
      {
        activities.map((a, i) => (
          <span class={`hand whitespace-nowrap text-2xl ${activityColors[i % 3]}`}>
            {a}
            {i < activities.length - 1 && <span class="mx-3 text-marigold-400" aria-hidden="true">&#10022;</span>}
          </span>
        ))
      }
    </p>

    <div class="reveal mt-10 text-center">
      <a href="/what-we-do" class="hand text-2xl text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900">
        the whole of chapter two: what we do &rarr;
      </a>
    </div>
  </div>

  <p class="hand pb-4 pr-6 text-right text-lg text-bark-700/50">&middot; three &middot;</p>
</section>
