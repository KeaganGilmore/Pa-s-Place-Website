---
// A seeded field of twinkling stars for the night pages.
// Mostly small dots; every few stars is a four-point sparkle.
interface Props {
  class?: string;
  count?: number;
  seed?: number;
}
const { class: className = '', count = 46, seed = 3 } = Astro.props;

const mulberry32 = (a: number) => () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = mulberry32(seed);

type Star = { x: number; y: number; r: number; delay: number; sparkle: boolean; warm: boolean };
const stars: Star[] = Array.from({ length: count }, (_, i) => ({
  x: rand() * 1000,
  y: rand() * 560,
  r: 0.8 + rand() * 1.6,
  delay: rand() * 4,
  sparkle: i % 7 === 3,
  warm: rand() > 0.45,
}));

const sparklePath = (x: number, y: number, s: number) =>
  `M${x} ${y - s} C${x + s * 0.22} ${y - s * 0.22} ${x + s * 0.22} ${y - s * 0.22} ${x + s} ${y} ` +
  `C${x + s * 0.22} ${y + s * 0.22} ${x + s * 0.22} ${y + s * 0.22} ${x} ${y + s} ` +
  `C${x - s * 0.22} ${y + s * 0.22} ${x - s * 0.22} ${y + s * 0.22} ${x - s} ${y} ` +
  `C${x - s * 0.22} ${y - s * 0.22} ${x - s * 0.22} ${y - s * 0.22} ${x} ${y - s} Z`;
---

<svg
  class={className}
  viewBox="0 0 1000 560"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    stars.map((s) =>
      s.sparkle ? (
        <path
          class="twinkle"
          style={`--tw-delay: ${s.delay.toFixed(1)}s`}
          d={sparklePath(s.x, s.y, s.r * 5)}
          fill={s.warm ? '#fbc968' : '#f7ecd2'}
        />
      ) : (
        <circle
          class="twinkle"
          style={`--tw-delay: ${s.delay.toFixed(1)}s`}
          cx={s.x.toFixed(1)}
          cy={s.y.toFixed(1)}
          r={s.r.toFixed(1)}
          fill={s.warm ? '#fbc968' : '#f7ecd2'}
        />
      )
    )
  }
</svg>
