---
// Sits between sections: renders a soft double wave in `fill`, laid over the
// previous section's background. `flip` points the crests downward.
interface Props {
  fill: string;
  flip?: boolean;
  class?: string;
}
const { fill, flip = false, class: className = '' } = Astro.props;
---

<div class={`${flip ? 'rotate-180' : ''} ${className}`} aria-hidden="true">
  <svg
    class="block h-[48px] w-full sm:h-[72px]"
    viewBox="0 0 1440 90"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0,58 C180,88 360,20 560,38 C760,56 900,90 1100,66 C1240,50 1360,26 1440,44 L1440,90 L0,90 Z"
      fill={fill}
      opacity="0.35"
    ></path>
    <path
      d="M0,70 C220,40 420,84 660,62 C880,42 1060,78 1250,60 C1330,52 1400,58 1440,64 L1440,90 L0,90 Z"
      fill={fill}
    ></path>
  </svg>
</div>
