---
// The Pa's Place mark: a rising sun over a wave.
interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="24" cy="22" r="9" fill="var(--color-sun-400)"></circle>
  <g stroke="var(--color-sun-400)" stroke-width="2.6" stroke-linecap="round">
    <path d="M24 6v3.5"></path>
    <path d="M35.3 10.7l-2.4 2.4"></path>
    <path d="M40 22h-3.5"></path>
    <path d="M12.7 10.7l2.4 2.4"></path>
    <path d="M8 22h3.5"></path>
  </g>
  <path
    d="M4 35c5-4.5 9-4.5 14 0s9 4.5 14 0 8-4.2 12-1"
    stroke="var(--color-sea-500)"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  ></path>
  <path
    d="M8 42c4.5-3.8 8.5-3.8 13 0s9 3.8 13.5 0"
    stroke="var(--color-sea-300)"
    stroke-width="2.6"
    stroke-linecap="round"
    fill="none"
  ></path>
</svg>
