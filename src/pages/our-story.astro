---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { getGallery, getSettings } from '../lib/cms';
import coastline from '../assets/images/coastline.webp';

const settings = await getSettings();
const gallery = await getGallery();

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{webp,jpg,jpeg,png}',
  { eager: true }
);
const house = gallery.find((g) => g.slug === 'the-house');
const houseImage = house ? allImages[house.image!]?.default : undefined;
---

<Layout title="Our Story" description="Why Pa's Place exists — a retreat in Pennington, KZN giving coastal holidays to disadvantaged children.">
  <!-- ============ PAGE HERO ============ -->
  <section class="relative overflow-hidden bg-bark-950">
    <Image
      src={coastline}
      alt=""
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-bark-950 via-bark-950/50 to-bark-950/70" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-28 sm:pt-36">
      <p class="fade-up text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-marigold-300" style="--d: 0.05s">Our story</p>
      <h1 class="fade-up mt-4 max-w-3xl font-display text-5xl font-semibold text-paper sm:text-6xl" style="--d: 0.18s">
        A breath of true holiday can relax the most troubled of young minds.
      </h1>
    </div>
    <WaveDivider fill="var(--color-paper)" class="relative" />
  </section>

  <!-- ============ THE MISSION, TOLD ============ -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-14 px-5 lg:grid-cols-[1.2fr_1fr]">
      <div class="max-w-xl space-y-6 text-lg text-cocoa/90">
        <p class="reveal">
          Pa&rsquo;s Place Non-Profit Company was founded with a simple mission:
          <strong class="text-bark-900">giving coastal, fun-filled holidays to disadvantaged children.</strong>
          Based in Kelso, Pennington, on KwaZulu-Natal&rsquo;s south coast, we provide affordable, comfortable,
          peaceful and activity-filled beachside accommodation.
        </p>
        <p class="reveal">
          But Pa&rsquo;s Place is more than accommodation. It&rsquo;s a retreat — one that lifts children out of
          buildings, classrooms and familiar concerns. With attention to communication, care with questions
          and energy toward activities, we&rsquo;ve learned how deeply a real holiday can settle a young mind.
        </p>
        <p class="reveal">
          Our days move with the tides — through the noisiest and the quietest hours. Beach going, trail
          walking, nature seeking, sports playing, team building, music and arts creating, unique foods
          preparing. And woven through all of it: learning. Whether it&rsquo;s a piece of marine life in a rock
          pool or a fruit hanging from a tree, children leave Pa&rsquo;s Place knowing something they didn&rsquo;t
          know before.
        </p>
        <p class="reveal">
          Our premises offer a quiet setting where natural creativity can spark into fun-filled noise — and
          our naturally abundant town is just the beginning. We aim to take children far and wide, to the
          most beautiful places KwaZulu-Natal holds.
        </p>
      </div>

      <aside class="reveal self-start lg:sticky lg:top-24">
        {
          houseImage && (
            <figure class="polaroid mx-auto max-w-sm !rotate-1">
              <Image
                src={houseImage}
                alt={house?.alt ?? "The Pa's Place house"}
                widths={[480, 760]}
                sizes="(min-width: 1024px) 30vw, 90vw"
                class="aspect-[4/3] w-full rounded-[3px] object-cover"
              />
              <figcaption class="pt-3 text-center font-display text-[1.05rem] italic text-cocoa/80">
                {house?.caption}
              </figcaption>
            </figure>
          )
        }
        <div class="mt-10 rounded-[1.8rem] bg-cream-100 p-7">
          <h2 class="font-display text-xl font-semibold text-bark-900">Where you&rsquo;ll find us</h2>
          <p class="mt-3 whitespace-pre-line text-cocoa/80">{settings.contact.address}</p>
          {
            settings.contact.mapUrl && (
              <a class="mt-3 inline-block font-bold text-sea-800 underline-offset-4 hover:underline" href={settings.contact.mapUrl}>
                Open the map &rarr;
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ FIRST-TIME SEA ============ -->
  <section class="relative">
    <WaveDivider fill="var(--color-cream-100)" />
    <div class="bg-cream-100 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-5 text-center">
        <h2 class="reveal text-4xl font-semibold text-bark-900 sm:text-5xl">
          Most of the children we host have
          <em class="squiggle font-display italic text-sea-600">never seen the sea</em>.
        </h2>
        <p class="reveal mx-auto mt-6 max-w-xl text-lg text-cocoa/85">
          Most disadvantaged children can only travel to the coast during school holidays — many never get
          the chance at all. It is our mission to sponsor holidays for children who have not yet been able
          to see the sea, and to keep our doors affordable for the families who need rest most.
        </p>
        <a href="/get-involved" class="btn btn-marigold mt-9">Help send a child to the sea</a>
      </div>
    </div>
  </section>
</Layout>
