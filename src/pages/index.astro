---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import HeroDay from '../components/story/scenes/HeroDay.astro';
import StayOptions from '../components/home/StayOptions.astro';
import ThePlace from '../components/home/ThePlace.astro';
import SceneAlbum from '../components/story/scenes/SceneAlbum.astro';
import LocationBand from '../components/home/LocationBand.astro';
import CharityNote from '../components/home/CharityNote.astro';
import { getGallery, getHomepage, getSettings } from '../lib/cms';
import coastline from '../assets/images/coastline.webp';

const homepage = await getHomepage();
const gallery = await getGallery();
const settings = await getSettings();

// CMS image fields store repo paths; resolve them to Astro's optimized assets.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{webp,jpg,jpeg,png}',
  { eager: true }
);
const resolve = (path: string | null) => (path ? allImages[path]?.default : undefined);

const heroImage = resolve(homepage.heroImage);
const house = gallery.find((g) => g.slug === 'the-house');
const houseImage = house?.image ? allImages[house.image]?.default : undefined;
const photos = gallery
  .map((g) => ({ meta: resolve(g.image), alt: g.alt, caption: g.caption }))
  .filter((g): g is { meta: ImageMetadata; alt: string; caption: string | null } => Boolean(g.meta));

const whatsapp = settings.contact.phoneLink
  ? `https://wa.me/${settings.contact.phoneLink.replace(/[^0-9]/g, '')}`
  : undefined;

// "R200 per person per night (minimum 4 people)" → chip-sized "R200 per person per night"
const priceChip = settings.pricing.accommodation?.split(' (')[0];
---

<Layout>
  <div id="storybook">
    {
      heroImage && (
        <HeroDay
          eyebrow={homepage.heroEyebrow ?? ''}
          title={homepage.heroTitle ?? ''}
          subtitle={homepage.heroSubtitle ?? ''}
          image={heroImage}
          imageAlt="Children playing ball on the golden beach in the late afternoon sun"
          priceChip={priceChip}
        />
      )
    }
    <StayOptions accommodation={settings.pricing.accommodation} venue={settings.pricing.venue} />
    <ThePlace
      housePhoto={houseImage}
      houseAlt={house?.alt ?? "The Pa's Place house"}
      houseCaption={house?.caption}
      beachPhoto={coastline}
      pricing={settings.pricing.accommodation ?? ''}
      phone={settings.contact.phone}
      phoneLink={settings.contact.phoneLink}
      whatsapp={whatsapp}
    />
    <SceneAlbum photos={photos} />
    <LocationBand address={settings.contact.address ?? ''} mapUrl={settings.contact.mapUrl} />
    <CharityNote />
  </div>
</Layout>
