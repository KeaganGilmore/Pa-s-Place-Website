---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import SunRays from '../components/SunRays.astro';
import { getGallery, getHomepage } from '../lib/cms';
import coastline from '../assets/images/coastline.webp';

const homepage = await getHomepage();
const gallery = await getGallery();

// CMS image fields store repo paths; resolve them to Astro's optimized assets.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{webp,jpg,jpeg,png}',
  { eager: true }
);
const resolve = (path: string | null) => (path ? allImages[path]?.default : undefined);

const heroImage = resolve(homepage.heroImage);
const photos = gallery
  .map((g) => ({ ...g, meta: resolve(g.image) }))
  .filter((g) => g.meta);

const activities = [
  'Beach going',
  'Trail walking',
  'Nature seeking',
  'Sports playing',
  'Team building',
  'Music making',
  'Arts creating',
  'Unique foods preparing',
  'Rock pool exploring',
  'Star gazing',
];

const pillars = [
  {
    title: 'Seaside retreats for children',
    text: 'Fun-filled, activity-packed holidays that lift children out of buildings, classrooms and familiar concerns — and into salt air, sea sand and discovery.',
    icon: 'sun',
  },
  {
    title: 'Affordable family holidays',
    text: 'Comfortable, peaceful beachside accommodation for families and groups who struggle to find the funds for a restful holiday in today’s economy.',
    icon: 'house',
  },
  {
    title: 'Community food & play days',
    text: 'Unique, filling meals prepared while local children gather to enjoy our playground and planned programmes of activity.',
    icon: 'pot',
  },
];
---

<Layout>
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-[94svh] items-end overflow-hidden bg-bark-950">
    {
      heroImage && (
        <Image
          src={heroImage}
          alt="A grandfather and child walking hand in hand through the dunes toward the sea"
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-bark-950/85 via-bark-950/15 to-bark-950/30" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-24 pt-40 sm:pb-28">
      <p class="fade-up text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-marigold-300" style="--d: 0.05s">
        {homepage.heroEyebrow}
      </p>
      <h1
        class="fade-up mt-5 max-w-3xl whitespace-pre-line font-display text-5xl font-semibold text-paper sm:text-6xl lg:text-7xl"
        style="--d: 0.18s"
      >
        {homepage.heroTitle}
      </h1>
      <p class="fade-up mt-6 max-w-xl text-lg text-cream-100/90 sm:text-xl" style="--d: 0.34s">
        {homepage.heroSubtitle}
      </p>
      <div class="fade-up mt-9 flex flex-wrap gap-4" style="--d: 0.5s">
        <a href="/get-involved" class="btn btn-marigold">Sponsor a holiday</a>
        <a href="/our-story" class="btn btn-paper">Read our story</a>
      </div>
    </div>

    <WaveDivider fill="var(--color-paper)" class="absolute inset-x-0 bottom-0 z-10" />
  </section>

  <!-- ============ MISSION ============ -->
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[1.15fr_1fr]">
      <div class="reveal">
        <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-marigold-600">Why we exist</p>
        <h2 class="mt-4 text-4xl font-semibold text-bark-900 sm:text-5xl">
          The greatest joy we witness is a child
          <em class="squiggle font-display italic text-sea-600">seeing the sea</em>
          for the very first time.
        </h2>
        <p class="mt-7 max-w-xl text-lg text-cocoa/85">
          Pa&rsquo;s Place is a non-profit company in Pennington, on KwaZulu-Natal&rsquo;s south coast, founded
          with one mission: giving coastal, fun-filled holidays to disadvantaged children.
        </p>
        <p class="mt-4 max-w-xl text-lg text-cocoa/85">
          More than accommodation, it&rsquo;s a retreat — a place where a breath of true holiday can relax
          the most troubled of young minds, and where every stay carries a little learning, whether it&rsquo;s
          a piece of marine life or a fruit on a tree.
        </p>
        <a href="/our-story" class="group mt-7 inline-flex items-center gap-2 font-bold text-sea-800">
          The whole story
          <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
        <SunRays class="absolute -right-12 -top-16 h-44 w-44 opacity-80 sm:-right-16 sm:h-56 sm:w-56" />
        <div class="polaroid relative !rotate-1">
          <Image
            src={coastline}
            alt="The Pennington coastline — a golden beach and an old bench facing the sea"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            class="aspect-[4/3] w-full rounded-[3px] object-cover"
          />
          <p class="pt-3 text-center font-display text-[1.05rem] italic text-cocoa/80">
            Pennington, KwaZulu-Natal — our stretch of the Indian Ocean
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PILLARS ============ -->
  <section class="relative">
    <WaveDivider fill="var(--color-cream-100)" />
    <div class="bg-cream-100 pb-24 pt-8 sm:pb-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal max-w-2xl">
          <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-sea-600">What we do</p>
          <h2 class="mt-4 text-4xl font-semibold text-bark-900 sm:text-5xl">Three ways we move with the tides</h2>
        </div>

        <div class="mt-14 grid gap-8 md:grid-cols-3">
          {
            pillars.map((p, i) => (
              <article
                class={`reveal rounded-[1.8rem] bg-paper p-8 shadow-[0_20px_40px_-24px_rgb(51_41_28/0.4)] ${
                  i === 0 ? 'md:-rotate-1' : i === 2 ? 'md:rotate-1' : 'md:translate-y-4'
                }`}
              >
                <div class="grid h-14 w-14 place-items-center rounded-2xl bg-marigold-400/15 text-marigold-600">
                  {p.icon === 'sun' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
                      <circle cx="12" cy="12" r="4.2" />
                      <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
                    </svg>
                  )}
                  {p.icon === 'house' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3.5 10.5 12 4l8.5 6.5" />
                      <path d="M6 9.5V19a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9.5" />
                      <path d="M10 20v-5h4v5" />
                    </svg>
                  )}
                  {p.icon === 'pot' && (
                    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 10h16v4a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-4Z" />
                      <path d="M2 10h20" />
                      <path d="M9 6c0-1 .5-1.5.5-2.5M14.5 6c0-1 .5-1.5.5-2.5" />
                    </svg>
                  )}
                </div>
                <h3 class="mt-6 text-2xl font-semibold text-bark-900">{p.title}</h3>
                <p class="mt-3 text-cocoa/80">{p.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ACTIVITIES MARQUEE ============ -->
  <section class="bg-bark-900 py-10" aria-label="Activities at Pa's Place">
    <div class="marquee">
      <div class="marquee-track" aria-hidden="true">
        {
          [...activities, ...activities].map((a) => (
            <span class="flex items-center gap-3 whitespace-nowrap font-display text-2xl italic text-cream-100/90">
              <svg class="h-3.5 w-3.5 text-marigold-400" viewBox="0 0 12 12" fill="currentColor">
                <path d="M6 0l1.4 4.6L12 6l-4.6 1.4L6 12 4.6 7.4 0 6l4.6-1.4Z" />
              </svg>
              {a}
            </span>
          ))
        }
      </div>
      <p class="sr-only">{activities.join(', ')}</p>
    </div>
  </section>

  <!-- ============ GALLERY ============ -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="text-[0.72rem] font-extrabold uppercase tracking-[0.28em] text-marigold-600">The family album</p>
          <h2 class="mt-4 text-4xl font-semibold text-bark-900 sm:text-5xl">Days at Pa&rsquo;s Place</h2>
        </div>
        <p class="max-w-xs pb-1 text-sm italic text-bark-700/80">
          A growing album — swapped and captioned by our own hands through the site&rsquo;s CMS.
        </p>
      </div>

      <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          photos.map((p) => (
            <figure class="polaroid reveal">
              <Image
                src={p.meta!}
                alt={p.alt}
                widths={[400, 640, 900]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                class="aspect-square w-full rounded-[3px] object-cover"
              />
              {p.caption && (
                <figcaption class="pt-3 text-center font-display text-[1.05rem] italic leading-snug text-cocoa/80">
                  {p.caption}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CLOSING CTA ============ -->
  <section class="relative">
    <WaveDivider fill="var(--color-bark-950)" />
    <div class="bg-bark-950 pb-4 pt-16 text-center sm:pt-20">
      <div class="mx-auto max-w-3xl px-5">
        <SunRays class="mx-auto h-16 w-16" color="var(--color-marigold-400)" />
        <h2 class="reveal mt-6 font-display text-4xl font-semibold italic text-paper sm:text-5xl">
          For R200 a night, a child who has only heard of the ocean can fall asleep to the sound of it.
        </h2>
        <p class="mt-6 text-lg text-cream-100/75">
          Sponsor a holiday, book a stay that funds one, or simply come lend a hand.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-4 pb-10">
          <a href="/get-involved" class="btn btn-marigold">Get involved</a>
          <a href="/what-we-do" class="btn btn-paper">See what we do</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
