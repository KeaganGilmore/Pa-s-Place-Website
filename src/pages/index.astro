---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import SceneCover from '../components/story/scenes/SceneCover.astro';
import StayBand from '../components/story/scenes/StayBand.astro';
import MissionMoment from '../components/story/scenes/MissionMoment.astro';
import SceneTides from '../components/story/scenes/SceneTides.astro';
import SceneAlbum from '../components/story/scenes/SceneAlbum.astro';
import SceneTurnPage from '../components/story/scenes/SceneTurnPage.astro';
import { getGallery, getHomepage, getSettings } from '../lib/cms';

const homepage = await getHomepage();
const gallery = await getGallery();
const settings = await getSettings();

// CMS image fields store repo paths; resolve them to Astro's optimized assets.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{webp,jpg,jpeg,png}',
  { eager: true }
);
const resolve = (path: string | null) => (path ? allImages[path]?.default : undefined);

const heroImage = resolve(homepage.heroImage);
const house = gallery.find((g) => g.slug === 'the-house');
const houseImage = house?.image ? allImages[house.image]?.default : undefined;
const photos = gallery
  .map((g) => ({ meta: resolve(g.image), alt: g.alt, caption: g.caption }))
  .filter((g): g is { meta: ImageMetadata; alt: string; caption: string | null } => Boolean(g.meta));

const whatsapp = settings.contact.phoneLink
  ? `https://wa.me/${settings.contact.phoneLink.replace(/[^0-9]/g, '')}`
  : undefined;
---

<Layout headerTheme="night">
  <div id="storybook">
    <SceneCover eyebrow={homepage.heroEyebrow ?? ''} title={homepage.heroTitle ?? ''} subtitle={homepage.heroSubtitle ?? ''} />
    <StayBand
      photo={houseImage}
      photoAlt={house?.alt ?? "The Pa's Place house"}
      pricing={settings.pricing.accommodation ?? ''}
      phone={settings.contact.phone}
      phoneLink={settings.contact.phoneLink}
      whatsapp={whatsapp}
    />
    {
      heroImage && (
        <MissionMoment
          photo={heroImage}
          photoAlt="A grandfather and child walking hand in hand through the dunes toward the sea"
        />
      )
    }
    <SceneTides />
    <SceneAlbum photos={photos} />
    <SceneTurnPage />
  </div>
</Layout>

<script>
  import '../scripts/storybook';
</script>
