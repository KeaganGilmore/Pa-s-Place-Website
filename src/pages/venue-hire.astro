---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Sunburst from '../components/story/Sunburst.astro';
import TornEdge from '../components/story/TornEdge.astro';
import BookingEngine from '../components/booking/BookingEngine.tsx';
import { getGallery, getSettings } from '../lib/cms';

const settings = await getSettings();
const gallery = await getGallery();

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{webp,jpg,jpeg,png}',
  { eager: true }
);
const foodDay = gallery.find((g) => g.slug === 'food-day');
const foodImage = foodDay?.image ? allImages[foodDay.image]?.default : undefined;

const whatsappDigits = settings.contact.phoneLink?.replace(/[^0-9]/g, '') || undefined;

const facts = [
  { label: 'The rate', value: settings.pricing.venue },
  { label: 'What suits it', value: 'Birthdays, church gatherings, year-end functions, family days — long tables, big pots, loud lawns.' },
  { label: 'The setting', value: 'A peaceful garden with a playground, two minutes’ walk from the beach in Kelso, Pennington.' },
  { label: 'Sleeping over?', value: `Make a weekend of it — ${settings.pricing.accommodation}.` },
];

const steps = [
  { title: 'Pick your date', text: 'The calendar shows live availability — choose your day and how many are coming.' },
  { title: 'Pay the R500 deposit', text: 'Card or instant EFT, secured — your date is locked in the moment it clears.' },
  { title: 'Get your confirmation', text: 'A booking reference and directions land in your inbox. The balance is settled on the day.' },
];
---

<Layout title="Venue Hire" description="Hire the Pa's Place venue in Pennington, KZN for gatherings and day events — R80 per person, and every event funds children's holidays.">
  <!-- ============ HEADER ============ -->
  <section class="relative overflow-hidden bg-cream-100">
    <Sunburst class="absolute -right-16 -top-20 h-56 w-56 opacity-70 sm:-right-10 sm:h-72 sm:w-72" spin />
    <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-28 sm:pb-14 sm:pt-36">
      <p class="hand fade-up text-2xl text-marigold-600" style="--d: 0.05s">venue hire</p>
      <h1 class="fade-up mt-3 max-w-3xl font-display text-[2.6rem] font-semibold leading-[1.06] text-bark-900 sm:text-6xl" style="--d: 0.18s">
        Long tables, a loud lawn, and the sea up the road.
      </h1>
      <p class="hand fade-up mt-5 max-w-xl text-2xl text-bark-700/80" style="--d: 0.32s">
        {settings.pricing.venue} &mdash; and every event helps fund a child&rsquo;s holiday
      </p>
    </div>
    <TornEdge fill="var(--color-paper)" seed={101} class="relative" />
  </section>

  <!-- ============ THE BOOKING ENGINE ============ -->
  <section class="bg-paper py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-5">
      <div class="fade-up" style="--d: 0.15s">
        <BookingEngine
          client:load
          kind="venue"
          phone={settings.contact.phone}
          phoneLink={settings.contact.phoneLink}
          whatsapp={whatsappDigits ? `https://wa.me/${whatsappDigits}` : undefined}
        />
      </div>
      <p class="hand mt-6 text-center text-xl text-bark-700/75">
        rather book by voice? {settings.contact.phone && <a class="text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900" href={`tel:${settings.contact.phoneLink || settings.contact.phone}`}>call {settings.contact.person ?? 'us'} on {settings.contact.phone}</a>}
      </p>
    </div>
  </section>

  <!-- ============ THE VENUE, BRIEFLY ============ -->
  <section class="bg-paper pb-16">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2">
      {
        foodImage && (
          <figure class="keepsake reveal mx-auto max-w-md !-rotate-1">
            <Image
              src={foodImage}
              alt={foodDay?.alt ?? "A community food day at Pa's Place"}
              widths={[480, 800]}
              sizes="(min-width: 1024px) 40vw, 92vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <figcaption class="hand pt-3 text-center text-[1.4rem] text-cocoa/85">{foodDay?.caption ?? 'long tables, longer afternoons'}</figcaption>
          </figure>
        )
      }
      <div>
        <dl class="space-y-5">
          {
            facts.map((f) => (
              <div class="reveal flex gap-5 border-b border-dashed border-cream-300 pb-4">
                <dt class="hand w-32 shrink-0 text-xl leading-tight text-marigold-600">{f.label}</dt>
                <dd class="text-cocoa/85">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          settings.contact.mapUrl && (
            <a class="hand mt-4 inline-block text-xl text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900" href={settings.contact.mapUrl} target="_blank" rel="noopener">
              open the map &rarr;
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="relative">
    <TornEdge fill="var(--color-cream-100)" seed={103} class="bg-paper" />
    <div class="bg-cream-100 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="reveal text-center font-display text-3xl font-semibold text-bark-900 sm:text-4xl">Booking &amp; payment, in three small steps</h2>
        <ol class="mx-auto mt-12 grid max-w-4xl gap-8 sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class={`reveal relative rounded-[1.4rem] border-2 border-bark-900/10 bg-[#fffdf6] p-7 pt-9 text-center shadow-[0_20px_40px_-26px_rgb(24_18_10/0.5)] ${i === 0 ? 'sm:-rotate-1' : i === 2 ? 'sm:rotate-1' : 'sm:translate-y-3'}`}>
                <span class="tape" aria-hidden="true" />
                <span class="hand text-3xl text-marigold-500">{i + 1}.</span>
                <h3 class="mt-2 font-display text-xl font-semibold text-bark-900">{s.title}</h3>
                <p class="mt-2 text-cocoa/80">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="reveal hand mt-10 text-center text-2xl text-bark-700/75">
          staying the night instead? <a href="/book-a-stay" class="text-sea-800 underline decoration-marigold-400 decoration-2 underline-offset-4 hover:text-bark-900">book the house &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
