# Basic Auth for the CMS admin (/keystatic). Defaults: admin / rootpass —
# CHANGE THESE in production via Railway service variables.
CMS_USER=admin
CMS_PASSWORD=rootpass

# Keystatic storage mode: leave unset for local development (edits write to
# your working copy). Set to "github" in production so staff can edit from
# the live site (requires a Keystatic GitHub App — see README).
KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_REPO_OWNER=
KEYSTATIC_GITHUB_REPO_NAME=

# Required by Keystatic when KEYSTATIC_STORAGE=github (values come from the
# GitHub App created via the Keystatic setup flow):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
